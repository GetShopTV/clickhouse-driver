cabal-version:      3.0
name:               clickhouse-driver
version:            0.2.0.0
synopsis:           ClickHouse HTTP client (hcurl transport, RowBinary format)
description:
  Streaming ClickHouse client built on top of @hcurl@ (libcurl multi
  interface).  Query results and inserts use the binary @RowBinary@ /
  @RowBinaryWithNamesAndTypes@ wire format.
license:            BSD-3-Clause
build-type:         Simple
extra-source-files:
    README.md

common warnings
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns

library
  import:           warnings
  hs-source-dirs:   src
  other-modules:    Database.Clickhouse.Client.HTTP.Diagnostics
  exposed-modules:
      Database.ClickHouse
      Database.Clickhouse.Client.Execution
      Database.Clickhouse.Client.HTTP.Client
      Database.Clickhouse.Client.HTTP.Types
      Database.Clickhouse.Client.Types
      Database.Clickhouse.Conversion.Binary.Decode
      Database.Clickhouse.Conversion.Binary.Encode
      Database.Clickhouse.Conversion.Text.Escaped
      Database.Clickhouse.Conversion.ToClickhouse
      Database.Clickhouse.Conversion.Types
  build-depends:
      aeson
    , base          >=4.18 && <5
    , binary
    , bytestring
    , conduit
    , hcurl
    , http-types
    , resourcet
    , text
    , time
    , transformers
    , unliftio
    , uuid
    , vector
    , wide-word
  default-language: GHC2021

executable clickhouse-driver-example
  import:           warnings
  main-is:          Main.hs
  hs-source-dirs:   example
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      aeson
    , base
    , bytestring
    , clickhouse-driver
    , text
    , time
    , uuid
    , vector
  default-language: GHC2021

test-suite clickhouse-driver-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:
      ExecutionSpec
      HTTPMetricsSpec
      HTTPControlSpec
  hs-source-dirs:   test
  ghc-options:      -threaded
  build-depends:
      aeson
    , base
    , bytestring
    , clickhouse-driver
    , conduit
    , exceptions
    , hcurl
    , network
    , resourcet
    , retry
    , time
    , transformers
    , uuid
    , vector
  default-language: GHC2021

test-suite clickhouse-driver-integration
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test/integration
  ghc-options:      -threaded -rtsopts "-with-rtsopts=-T"
  build-depends:
      base
    , bytestring
    , clickhouse-driver
    , conduit
    , network
    , resourcet
    , text
    , time
    , uuid
    , vector
  default-language: GHC2021
